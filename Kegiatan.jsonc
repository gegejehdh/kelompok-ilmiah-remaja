
{
  "name": "Kegiatan",
  "type": "object",
  "properties": {
    "nama_kegiatan": {
      "type": "string",
      "minLength": 2,
      "maxLength": 150
    },
    "deskripsi": {
      "type": "string",
      "maxLength": 1000
    },
    "tanggal_kegiatan": {
      "type": "string",
      "format": "date"
    },
    "gambar": {
      "type": "string"
    }
  },
  "required": [
    "nama_kegiatan"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
